<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        深色主题。键名与 Light.xaml 完全一致，只有颜色不同；
        换主题时由 ThemeManager 整体替换本字典。
    -->
    <SolidColorBrush x:Key="App.WindowBackground" Color="#1E1F22" />
    <SolidColorBrush x:Key="App.SurfaceBackground" Color="#26272B" />
    <SolidColorBrush x:Key="App.SurfaceBorder" Color="#3B3D43" />
    <SolidColorBrush x:Key="App.ForegroundPrimary" Color="#E9EAEB" />
    <SolidColorBrush x:Key="App.ForegroundSecondary" Color="#A7ABB2" />
    <SolidColorBrush x:Key="App.ForegroundMuted" Color="#C6C9CE" />
    <SolidColorBrush x:Key="App.Accent" Color="#4C9DFF" />
    <SolidColorBrush x:Key="App.AccentHover" Color="#6DB1FF" />
    <SolidColorBrush x:Key="App.AccentPressed" Color="#3B8AE0" />
    <SolidColorBrush x:Key="App.AccentForeground" Color="#0B1524" />
    <SolidColorBrush x:Key="App.InputBackground" Color="#1B1C1F" />
    <SolidColorBrush x:Key="App.InputBorder" Color="#4A4D55" />
    <SolidColorBrush x:Key="App.ButtonBackground" Color="#2C2E33" />
    <SolidColorBrush x:Key="App.ButtonBorder" Color="#474A52" />
    <SolidColorBrush x:Key="App.ButtonHoverBackground" Color="#383B42" />
    <SolidColorBrush x:Key="App.ButtonPressedBackground" Color="#24262A" />
    <SolidColorBrush x:Key="App.Separator" Color="#3B3D43" />
    <SolidColorBrush x:Key="App.LogBackground" Color="#1B1C1F" />
    <SolidColorBrush x:Key="App.WarningForeground" Color="#F0B24A" />
    <SolidColorBrush x:Key="App.InfoCardBackground" Color="#1F2C3A" />
    <SolidColorBrush x:Key="App.InfoCardBorder" Color="#2C4359" />
    <SolidColorBrush x:Key="App.SelectionBackground" Color="#2B3B4F" />
    <SolidColorBrush x:Key="App.BadgeBackground" Color="#2E6DB4" />
    <SolidColorBrush x:Key="App.BadgeForeground" Color="#FFFFFF" />

    <!-- 输入框 -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource App.InputBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource App.ForegroundPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.InputBorder}" />
        <Setter Property="CaretBrush" Value="{DynamicResource App.ForegroundPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource App.Accent}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <!-- 按钮 -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource App.ButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource App.ForegroundPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.ButtonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.ButtonHoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.ButtonPressedBackground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource App.AccentForeground}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.AccentHover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.AccentHover}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsDefault" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.AccentPressed}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.AccentPressed}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 复选框 -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource App.ForegroundPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Border x:Name="Box"
                                    CornerRadius="3"
                                    Background="{DynamicResource App.InputBackground}"
                                    BorderBrush="{DynamicResource App.InputBorder}"
                                    BorderThickness="1" />
                            <Path x:Name="Check"
                                  Data="M 3,8 L 6.5,11.5 L 13,4"
                                  Stroke="{DynamicResource App.AccentForeground}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下拉框选项 -->
    <Style x:Key="App.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource App.ForegroundPrimary}" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.SelectionBackground}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.SelectionBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下拉框 -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource App.ForegroundPrimary}" />
        <Setter Property="Background" Value="{DynamicResource App.InputBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource App.ComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd"
                                            CornerRadius="4"
                                            BorderThickness="1"
                                            Background="{DynamicResource App.InputBackground}"
                                            BorderBrush="{DynamicResource App.InputBorder}">
                                        <Path Data="M 0,0 L 8,0 L 4,5 Z"
                                              Width="8"
                                              Height="5"
                                              Margin="0,0,10,0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Fill="{DynamicResource App.ForegroundSecondary}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade">
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,2,0,0"
                                    Background="{DynamicResource App.SurfaceBackground}"
                                    BorderBrush="{DynamicResource App.SurfaceBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分组框 -->
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource App.ForegroundPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentPresenter Grid.Row="0"
                                          ContentSource="Header"
                                          Margin="2,0,0,6"
                                          TextElement.FontSize="12"
                                          TextElement.FontWeight="SemiBold"
                                          TextElement.Foreground="{DynamicResource App.ForegroundSecondary}" />
                        <Border Grid.Row="1"
                                Background="{DynamicResource App.SurfaceBackground}"
                                BorderBrush="{DynamicResource App.SurfaceBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

<Window x:Class="Ps1Run.App.Views.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Ps1Run.App.Localization"
        xmlns:d="clr-namespace:Ps1Run.App.Localization"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/icon.ico"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource App.SurfaceBackground}"
        Foreground="{DynamicResource App.ForegroundPrimary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="96" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="{loc:T Hint.RulePathAlways}" Margin="0,0,0,12"
                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource App.ForegroundMuted}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T Label.RulePathInput}"
                   VerticalAlignment="Center" Margin="0,0,10,8" TextWrapping="Wrap" />
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" VerticalContentAlignment="Center"
                     Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{Binding Path}" />
            <Button Grid.Column="1" Content="{loc:T Button.SelectScript}" d:DesignText.Text="选择文件…"
                    Padding="12,4" Margin="8,0,0,0" Click="OnPickFileClick" />
        </Grid>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T Label.RuleAction}"
                   VerticalAlignment="Center" Margin="0,0,10,8" />
        <ComboBox Grid.Row="2" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                  Margin="0,0,0,8" SelectedIndex="{Binding ActionIndex, Mode=TwoWay}">
            <ComboBoxItem Content="{loc:T Rule.Action.Run}" d:DesignText.Text="执行" />
            <ComboBoxItem Content="{loc:T Rule.Action.Edit}" d:DesignText.Text="编辑" />
        </ComboBox>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:T Group.RuleCriteria}"
                   VerticalAlignment="Top" Margin="0,0,10,8" />
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CriteriaSummary}"
                   TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource App.ForegroundSecondary}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:T Hint.RuleHash}"
                   VerticalAlignment="Top" Margin="0,0,10,8" TextWrapping="Wrap"
                   FontSize="11" Foreground="{DynamicResource App.ForegroundMuted}" />
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PreviewText}"
                   TextWrapping="Wrap" Margin="0,0,0,8"
                   FontSize="11" Foreground="{DynamicResource App.ForegroundSecondary}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding ErrorMessage}"
                   TextWrapping="Wrap" Margin="0,0,0,8"
                   FontSize="11" Foreground="{DynamicResource App.WarningForeground}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{loc:T Button.RuleCancel}" Padding="16,6" IsCancel="True"
                    Click="OnCancelClick" />
            <Button Content="{loc:T Button.RuleOk}" Padding="16,6" Margin="8,0,0,0"
                    IsDefault="True" Click="OnOkClick" />
        </StackPanel>
    </Grid>
</Window>

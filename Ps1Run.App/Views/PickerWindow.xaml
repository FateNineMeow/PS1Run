<Window x:Class="Ps1Run.App.Views.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Ps1Run.App.Localization"
        xmlns:d="clr-namespace:Ps1Run.App.Localization"
        Title="{loc:T Picker.Title}"
        Icon="pack://application:,,,/icon.ico"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        Topmost="True"
        Background="{DynamicResource App.SurfaceBackground}"
        Foreground="{DynamicResource App.ForegroundPrimary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding DisplayName}"
                   FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Row="1" Text="{Binding ScriptPath}" Margin="0,6,0,0"
                   Foreground="{DynamicResource App.ForegroundSecondary}" TextWrapping="Wrap" FontSize="12" />

        <!-- 执行时使用的解释器标识（PS5 / PS7 + 判定依据） -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="10,8"
                CornerRadius="5" Background="{DynamicResource App.InfoCardBackground}"
                BorderBrush="{DynamicResource App.InfoCardBorder}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource App.BadgeBackground}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PowerShellBadgeText}"
                                   Foreground="{DynamicResource App.BadgeForeground}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="{Binding PowerShellTitle}" Margin="8,0,0,0"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Text="{Binding PowerShellDetail}" Margin="0,5,0,0"
                           FontSize="11" Foreground="{DynamicResource App.ForegroundSecondary}" TextWrapping="Wrap"
                           ToolTip="{Binding PowerShellPath}" />
                <TextBlock Text="{Binding PowerShellWarning}" Margin="0,4,0,0"
                           FontSize="11" Foreground="{DynamicResource App.WarningForeground}" TextWrapping="Wrap"
                           Visibility="{Binding HasPowerShellWarning, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,14,0,0" VerticalAlignment="Top">
            <!-- 执行程序/编辑器配置缺失或路径失效时的红字提醒 -->
            <TextBlock Text="{Binding ConfigWarningText}" Margin="0,0,0,10"
                       FontSize="11" Foreground="{DynamicResource App.WarningForeground}" TextWrapping="Wrap"
                       Visibility="{Binding HasConfigWarning, Converter={StaticResource BoolToVisibility}}" />
            <!-- 语言文件缺版本号时的红字提醒：说明部分文字可能回退中文 -->
            <TextBlock Text="{Binding PackWarningText}" Margin="0,0,0,10"
                       FontSize="11" Foreground="{DynamicResource App.WarningForeground}" TextWrapping="Wrap"
                       Visibility="{Binding HasPackWarning, Converter={StaticResource BoolToVisibility}}" />
            <CheckBox Content="{loc:T Picker.Remember}" d:DesignText.Text="以后都这样处理（不再询问）"
                      IsChecked="{Binding RememberChoice, Mode=TwoWay}" />
            <CheckBox Content="{loc:T Picker.RememberScript}" d:DesignText.Text="以后都这样处理（仅此脚本）"
                      Margin="0,6,0,0" IsChecked="{Binding RememberForScript, Mode=TwoWay}"
                      ToolTip="{loc:T Picker.RememberScriptTip}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:T Picker.Cancel}" d:DesignText.Text="取消 (Esc)" Padding="16,6" IsCancel="True" Click="OnCancelClick" />
            <Button Content="{loc:T Picker.Edit}" d:DesignText.Text="编辑 (E)" Padding="16,6" Margin="8,0,0,0" Click="OnEditClick" />
            <Button Content="{loc:T Picker.Run}" d:DesignText.Text="执行 (Enter)" Padding="16,6" Margin="8,0,0,0"
                    IsDefault="True" Click="OnRunClick" />
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="Ps1Run.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Ps1Run.App.Localization"
        Title="{loc:T App.Title}"
        Icon="pack://application:,,,/icon.ico"
        Height="760" Width="900" MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.WindowBackground}"
        Foreground="{DynamicResource App.ForegroundPrimary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 规则列表：DataGrid 列头 / 行跟随深浅色主题，避免深色下列头仍是白底浅字 -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource App.InfoCardBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource App.ForegroundPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.SurfaceBorder}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource App.SurfaceBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource App.ForegroundPrimary}" />
        </Style>

        <!-- 语言项：显式模板，保证折叠态与下拉项都显示语言名而不是 ToString() -->
        <DataTemplate x:Key="LanguageItemTemplate">
            <TextBlock Text="{Binding DisplayName}" />
        </DataTemplate>

        <!-- 页签：扁平样式，选中项用底部 2px 强调色下划线（默认 3D 凸起样式太旧） -->
        <Style x:Key="MainTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource App.ForegroundSecondary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="16,8" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush"
                                        Value="{DynamicResource App.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background"
                                        Value="{DynamicResource App.ButtonHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource App.ForegroundPrimary}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource MainTabItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="Transparent"
                                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource App.Separator}">
                                <TabPanel IsItemsHost="True" Background="Transparent" />
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                              ContentSource="SelectedContent" Margin="0,12,0,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关联状态徽标：未注册为灰底描边，完整注册为强调色实心，部分注册为浅色卡片 -->
        <Style x:Key="AssociationBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource App.SurfaceBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.SurfaceBorder}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AssociationBadgeState}" Value="Full">
                    <Setter Property="Background" Value="{DynamicResource App.BadgeBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource App.BadgeBackground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AssociationBadgeState}" Value="Partial">
                    <Setter Property="Background" Value="{DynamicResource App.InfoCardBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource App.InfoCardBorder}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AssociationBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource App.ForegroundPrimary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AssociationBadgeState}" Value="Full">
                    <Setter Property="Foreground" Value="{DynamicResource App.BadgeForeground}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 关联页状态卡片 -->
        <Style x:Key="AssociationCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource App.InfoCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.InfoCardBorder}" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 + 常驻关联徽标：任何页签都能看到当前关联状态 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="PS1Run" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{loc:T App.Subtitle}"
                           Foreground="{DynamicResource App.ForegroundSecondary}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource AssociationBadgeStyle}">
                <TextBlock Text="{Binding AssociationBadgeText}"
                           Style="{StaticResource AssociationBadgeTextStyle}" />
            </Border>
        </Grid>

        <TabControl Grid.Row="1" Style="{StaticResource MainTabControlStyle}">

            <!-- ============ 常规：双击行为 ============ -->
            <TabItem Header="{loc:T Tab.General}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">

                        <GroupBox Header="{loc:T Group.RunMode}" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <ComboBox SelectedIndex="{Binding RunModeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="{loc:T RunMode.Run}" />
                                    <ComboBoxItem Content="{loc:T RunMode.Edit}" />
                                    <ComboBoxItem Content="{loc:T RunMode.Ask}" />
                                </ComboBox>
                                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource App.ForegroundSecondary}"
                                           TextWrapping="Wrap" Text="{loc:T Hint.RunMode}" />
                            </StackPanel>
                        </GroupBox>

                        <!-- 执行程序与编辑器同组：三者都属于"双击脚本时交给谁"，放在一处便于对照 -->
                        <GroupBox Header="{loc:T Group.Executor}" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <ComboBox SelectedIndex="{Binding PolicyIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="{loc:T Policy.Ps5}" />
                                    <ComboBoxItem Content="{loc:T Policy.Ps7}" />
                                    <ComboBoxItem Content="{loc:T Policy.Auto}" />
                                </ComboBox>
                                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource App.ForegroundSecondary}"
                                           TextWrapping="Wrap" Text="{loc:T Hint.Executor}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Label.Ps5}"
                                               VerticalAlignment="Center" Margin="0,0,8,4" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding CustomPs5Path, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Row="0" Grid.Column="2" Content="{loc:T Button.Browse}"
                                            Padding="12,4" Margin="8,0,0,4" Click="OnPickPs5Click" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T Label.Ps7}"
                                               VerticalAlignment="Center" Margin="0,0,8,8" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding CustomPs7Path, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Row="1" Grid.Column="2" Content="{loc:T Button.Browse}"
                                            Padding="12,4" Margin="8,0,0,8" Click="OnPickPs7Click" />

                                    <Rectangle Grid.Row="2" Grid.ColumnSpan="3" Height="1" Margin="0,0,0,8"
                                               Fill="{DynamicResource App.Separator}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:T Label.Editor}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Row="3" Grid.Column="1" VerticalContentAlignment="Center"
                                             Text="{Binding CustomEditorPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Row="3" Grid.Column="2" Content="{loc:T Button.Browse}"
                                            Padding="12,4" Margin="8,0,0,0" Click="OnPickEditorClick" />
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:T Group.Detect}" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{loc:T Button.Detect}"
                                        Padding="16,8" Click="OnAutoDetectClick" />
                                <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.ForegroundMuted}" TextWrapping="Wrap"
                                           Text="{Binding DetectionText}" />
                            </Grid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 脚本规则 ============ -->
            <TabItem Header="{loc:T Tab.Rules}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">

                        <GroupBox Header="{loc:T Group.RuleCriteria}" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:T Hint.RulePathAlways}" Margin="0,0,0,8"
                                           Foreground="{DynamicResource App.ForegroundSecondary}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    
                                <CheckBox Content="{loc:T Label.RuleSize}" Margin="0,0,0,6"
                                          IsChecked="{Binding RuleMatchSize, Mode=TwoWay}" />
                                <CheckBox Content="{loc:T Label.RuleModifiedTime}" Margin="0,0,0,6"
                                          IsChecked="{Binding RuleMatchModifiedTime, Mode=TwoWay}" />
                                          </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <CheckBox Content="{loc:T Label.RuleHash}"
                                          IsChecked="{Binding RuleMatchHash, Mode=TwoWay}" />
                                <TextBlock Text="{loc:T Hint.RuleHash}" Margin="0,6,0,0"
                                           FontSize="11" Foreground="{DynamicResource App.ForegroundMuted}"
                                           TextWrapping="Wrap" />
                                                     </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:T Group.RuleList}" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="190" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Label.RuleSearch}"
                                           VerticalAlignment="Center" Margin="0,0,8,8" />
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding RuleSearchText, UpdateSourceTrigger=PropertyChanged}" />

                                <DataGrid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                          ItemsSource="{Binding FilteredRules}"
                                          SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          SelectionMode="Single" CanUserAddRows="False"
                                          MouseDoubleClick="OnRuleRowDoubleClick"
                                          Background="{DynamicResource App.SurfaceBackground}"
                                          Foreground="{DynamicResource App.ForegroundPrimary}"
                                          BorderBrush="{DynamicResource App.SurfaceBorder}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:T Column.RulePath}"
                                                            Binding="{Binding Path}" Width="*" MinWidth="220" />
                                        <DataGridTextColumn Header="{loc:T Column.RuleAction}"
                                                            Binding="{Binding ActionToken}" Width="60" />
                                        <DataGridTextColumn Header="{loc:T Column.RuleSize}"
                                                            Binding="{Binding SizeText}" Width="90" />
                                        <DataGridTextColumn Header="{loc:T Column.RuleModifiedTime}"
                                                            Binding="{Binding ModifiedTimeUtc}" Width="190" />
                                        <DataGridTextColumn Header="{loc:T Column.RuleHash}"
                                                            Binding="{Binding HashText}" Width="190" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Orientation="Horizontal" Margin="0,10,0,4">
                                    <Button Content="{loc:T Button.RuleRefresh}" Padding="14,6" Margin="0,4,8,4"
                                            Click="OnRuleRefreshClick" />
                                    <Button Content="{loc:T Button.RuleAdd}" Padding="14,6" Margin="0,4,8,4"
                                            Click="OnRuleAddClick" />
                                    <Button Content="{loc:T Button.RuleEdit}" Padding="14,6" Margin="0,4,8,4"
                                            Click="OnRuleEditClick" />
                                    <Button Content="{loc:T Button.RuleDelete}" Padding="14,6" Margin="0,4,8,4"
                                            Click="OnRuleDeleteClick" />
                                    <Button Content="{loc:T Button.RuleSave}" Padding="14,6" Margin="0,4,8,4"
                                            Click="OnRuleSaveClick" />
                                </WrapPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding RuleStatusText}" Margin="0,4,0,0"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RuleStatusText}"
                                           Foreground="{DynamicResource App.ForegroundMuted}" />
                            </Grid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 文件关联 ============ -->
            <TabItem Header="{loc:T Tab.Association}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">

                        <GroupBox Header="{loc:T Group.AssociationStatus}" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <Border Style="{StaticResource AssociationCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="88" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Label.Verbs}"
                                                   Foreground="{DynamicResource App.ForegroundSecondary}"
                                                   Margin="0,0,12,6" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AssociationVerbsText}"
                                                   Margin="0,0,0,6" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T Label.Extension}"
                                                   Foreground="{DynamicResource App.ForegroundSecondary}"
                                                   Margin="0,0,12,6" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AssociationExtensionText}"
                                                   Margin="0,0,0,6" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T Status.ExecutablePath}"
                                                   Foreground="{DynamicResource App.ForegroundSecondary}"
                                                   Margin="0,0,12,6" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ExecutablePath}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding ExecutablePath}" Margin="0,0,0,6" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:T Status.UserChoice}"
                                                   Foreground="{DynamicResource App.ForegroundSecondary}"
                                                   Margin="0,0,12,0" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AssociationUserChoiceText}"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource App.ForegroundPrimary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AssociationUserChoiceOverridden}"
                                                                     Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource App.WarningForeground}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource App.ForegroundMuted}"
                                           Text="{loc:T Hint.Association}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="{loc:T Group.Actions}" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="{loc:T Button.Register}" Padding="16,6" Margin="0,4,8,4"
                                            Click="OnRegisterClick" />
                                    <Button Content="{loc:T Button.Unregister}" Padding="16,6" Margin="0,4,8,4"
                                            Click="OnUnregisterClick" />
                                    <Button Content="{loc:T Button.OpenWith}" Padding="16,6" Margin="0,4,8,4"
                                            Click="OnOpenWithClick" />
                                    <Button Content="{loc:T Button.OpenDefaultApps}" Padding="16,6" Margin="0,4,8,4"
                                            Click="OnOpenDefaultAppsClick" />
                                </WrapPanel>
                                <Rectangle Height="1" Margin="0,8,0,4" Fill="{DynamicResource App.Separator}" />
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="{loc:T Button.RegisterMachine}" Padding="16,6" Margin="0,4,8,4"
                                            Click="OnRegisterMachineClick" />
                                    <Button Content="{loc:T Button.UnregisterMachine}" Padding="16,6" Margin="0,4,8,4"
                                            Click="OnUnregisterMachineClick" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 日志与外观 ============ -->
            <TabItem>
                <!-- 语言文件缺少版本号时，标题右侧挂红色"！"徽标 -->
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:T Tab.LogsAndAppearance}" VerticalAlignment="Center" />
                        <Border x:Name="VersionBadge" Margin="6,0,0,0" Padding="5,0" CornerRadius="7"
                                VerticalAlignment="Center" Background="{DynamicResource App.WarningForeground}"
                                ToolTip="{Binding VersionWarningText}"
                                Visibility="{Binding HasVersionWarning, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="！" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource App.WindowBackground}" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">

                        <!-- 语言包版本提醒：语言文件缺版本号时显示，附一键重建 zh-cn.lang -->
                        <Border Padding="12" CornerRadius="6" Margin="0,0,0,12"
                                Background="{DynamicResource App.InfoCardBackground}"
                                BorderBrush="{DynamicResource App.WarningForeground}" BorderThickness="1"
                                Visibility="{Binding HasVersionWarning, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{loc:T Warning.Title}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.WarningForeground}" />
                                <TextBlock Text="{Binding VersionWarningText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{DynamicResource App.WarningForeground}" />
                                <Button Content="{loc:T Button.RebuildLanguagePack}" Padding="12,4"
                                        HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Click="OnRebuildLanguagePackClick" />
                            </StackPanel>
                        </Border>

                        <GroupBox Header="{loc:T Group.Logs}" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="104" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Label.LogDays}"
                                           VerticalAlignment="Center" Margin="0,0,12,8" />
                                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Width="90" VerticalContentAlignment="Center"
                                             Text="{Binding LogDaysText, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1" Content="{loc:T Button.PruneNow}" Padding="12,4"
                                            Margin="8,0,0,0" Click="OnPruneNowClick" />
                                    <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource App.ForegroundSecondary}"
                                               TextWrapping="Wrap" Text="{loc:T Hint.LogDays}" />
                                </Grid>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T Status.LogDirectory}"
                                           Foreground="{DynamicResource App.ForegroundSecondary}"
                                           VerticalAlignment="Center" Margin="0,0,12,8" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LogDirectory}"
                                           VerticalAlignment="Center" Margin="0,0,0,8"
                                           Foreground="{DynamicResource App.ForegroundSecondary}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding LogDirectory}" />

                                <WrapPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{loc:T Button.OpenLogFolder}" Padding="16,6" Margin="0,4,8,4"
                                            Click="OnOpenLogFolderClick" />
                                    <Button Content="{loc:T Button.OpenCurrentLog}" Padding="16,6" Margin="0,4,8,4"
                                            Click="OnOpenCurrentLogClick" />
                                    <Button Content="{loc:T Button.CopyRecentLogs}" Padding="16,6" Margin="0,4,8,4"
                                            Click="OnCopyRecentLogsClick" />
                                </WrapPanel>
                            </Grid>
                        </GroupBox>

                        <!-- 外观与语言：随日志页签一起作为"本机偏好与维护"入口 -->
                        <GroupBox Header="{loc:T Group.Appearance}" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="104" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Label.Theme}"
                                           VerticalAlignment="Center" Margin="0,0,12,8" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Width="280" HorizontalAlignment="Left"
                                          Margin="0,0,0,8" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="{loc:T Theme.Auto}" />
                                    <ComboBoxItem Content="{loc:T Theme.Light}" />
                                    <ComboBoxItem Content="{loc:T Theme.Dark}" />
                                </ComboBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T Label.Language}"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="LanguageCombo"
                                          Width="280" HorizontalAlignment="Left"
                                          ItemsSource="{Binding Languages}"
                                          ItemTemplate="{StaticResource LanguageItemTemplate}"
                                          SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" />
                            </Grid>
                        </GroupBox>

                        <!-- 配置文件与版本：配置统一为 config.cfg 一份；旧 JSON 文件已废弃 -->
                        <GroupBox Header="{loc:T Group.SettingsFiles}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="104" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:T Label.ConfigFile}"
                                           Foreground="{DynamicResource App.ForegroundSecondary}"
                                           VerticalAlignment="Center" Margin="0,0,12,8" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConfigFilePath}"
                                           VerticalAlignment="Center" Margin="0,0,0,8"
                                           Foreground="{DynamicResource App.ForegroundSecondary}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfigFilePath}" />
                                <Button Grid.Row="0" Grid.Column="2" Content="{loc:T Button.OpenConfig}"
                                        Padding="12,4" Margin="8,0,0,8" Click="OnOpenConfigClick" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:T Label.AppVersion}"
                                           Foreground="{DynamicResource App.ForegroundSecondary}"
                                           VerticalAlignment="Center" Margin="0,0,12,8" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding AppVersionText}"
                                           VerticalAlignment="Center" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:T Label.LanguagePack}"
                                           Foreground="{DynamicResource App.ForegroundSecondary}"
                                           VerticalAlignment="Center" Margin="0,0,12,8" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding LanguagePackVersionText}"
                                           VerticalAlignment="Center" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="{loc:T Hint.Version}"
                                           FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource App.ForegroundMuted}" TextWrapping="Wrap" />
                                <Button Grid.Row="3" Grid.Column="2" Content="{loc:T Button.Save}"
                                        Padding="16,6" Margin="8,4,0,0" Click="OnSaveClick" />
                            </Grid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底部状态条：不再堆放所有按钮 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- 状态条：显示最近一次操作反馈，无反馈时显示"更改即时生效" -->
            <TextBlock Grid.Column="0" Text="{Binding BottomHint}" VerticalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource App.ForegroundMuted}"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding BottomHint}" />
            <Button Grid.Column="1" Content="{loc:T Button.Close}" Padding="20,6" MinWidth="88"
                    Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
